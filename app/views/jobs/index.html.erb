<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">施工案件一覧</h1>
    <%= link_to "新規作成", new_job_path, class: "px-4 py-2 bg-cyan-500 text-white rounded-md hover:bg-cyan-600" %>
  </div>

  <% if @jobs.any? %>
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">案件番号</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">メーカー</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">車両情報</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">顧客名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ステータス</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">担当者</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">予定日</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @jobs.each do |job| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to job.job_serial, job_path(job), class: "text-cyan-600 hover:text-cyan-900" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap"><%= job.maker.name %></td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-900"><%= job.vehicle_name %></div>
                <div class="text-sm text-gray-500"><%= job.vehicle_model %> / <%= job.car_year %>年 / <%= job.car_color %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900"><%= job.customer_name %></div>
                <div class="text-sm text-gray-500"><%= job.customer_phone %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% status_class = case job.status
                     when "draft" then "bg-gray-100 text-gray-800"
                     when "in_progress" then "bg-blue-100 text-blue-800"
                     when "completed" then "bg-green-100 text-green-800"
                     when "cancelled" then "bg-red-100 text-red-800"
                     end %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
                  <% status_text = case job.status
                       when "draft" then "下書き"
                       when "in_progress" then "施工中"
                       when "completed" then "完了"
                       when "cancelled" then "キャンセル"
                       end %>
                  <%= status_text %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap"><%= job.owner.name %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= job.scheduled_at&.strftime("%Y/%m/%d") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <%= link_to "編集", edit_job_path(job), class: "text-cyan-600 hover:text-cyan-900 mr-3" %>
                <%= button_to "削除", job_path(job), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "text-red-600 hover:text-red-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded-lg p-8 text-center">
      <p class="text-gray-500 mb-4">施工案件がまだ登録されていません。</p>
      <%= link_to "最初の案件を作成する", new_job_path, class: "px-4 py-2 bg-cyan-500 text-white rounded-md hover:bg-cyan-600" %>
    </div>
  <% end %>
</div>
