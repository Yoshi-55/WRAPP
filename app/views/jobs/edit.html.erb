<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-900">施工案件編集</h1>
      <%= link_to "詳細に戻る", job_path(@job), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50" %>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6">
      <%= form_with model: @job, class: "space-y-6" do |f| %>
        <% if @job.errors.any? %>
          <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded">
            <h3 class="font-bold mb-2"><%= pluralize(@job.errors.count, "個") %>のエラーがあります：</h3>
            <ul class="list-disc list-inside">
              <% @job.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :maker_id, "メーカー", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :maker_id, @makers, :id, :name, { prompt: "選択してください" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div>
          <%= f.label :vehicle_name, "車名", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :vehicle_name, placeholder: "例: レクサス LC", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div>
          <%= f.label :vehicle_model, "グレード", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :vehicle_model, placeholder: "例: LC500h", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div>
          <%= f.label :status, "ステータス", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :status, [["下書き", "draft"], ["施工中", "in_progress"], ["完了", "completed"], ["キャンセル", "cancelled"]], {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div>
          <%= f.label :car_year, "年式", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :car_year, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div>
          <%= f.label :car_color, "車両カラー", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :car_color, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div>
          <%= f.label :customer_name, "顧客名", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :customer_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div>
          <%= f.label :customer_phone, "顧客電話番号", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.telephone_field :customer_phone, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div>
          <%= f.label :scheduled_at, "予定日", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.datetime_local_field :scheduled_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div>
          <%= f.label :completed_at, "完了日", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.datetime_local_field :completed_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div>
          <%= f.label :note, "備考", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :note, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-cyan-500 focus:ring focus:ring-cyan-200" %>
        </div>

        <div class="flex justify-end space-x-3">
          <%= link_to "キャンセル", job_path(@job), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50" %>
          <%= f.submit "更新する", class: "px-4 py-2 bg-cyan-500 text-white rounded-md hover:bg-cyan-600" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
